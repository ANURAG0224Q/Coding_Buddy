# Optional server-side ("Default AI") credentials. Set one of these so the app works
# out of the box; leave both unset and visitors must bring their own API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Any OpenAI-compatible gateway instead of api.openai.com:
OPENAI_BASE_URL=

# Which server key the "Default AI" badge should use when both are set.
DEFAULT_PROVIDER=

# Dev ports (defaults: API 8787, Vite 3000)
PORT=8787
API_URL=http://localhost:8787
